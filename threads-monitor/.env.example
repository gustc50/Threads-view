# =========================================================
# Arquivo de exemplo. Copie para ".env" e preencha os valores.
# NUNCA envie o arquivo .env real para o Git.
# =========================================================

# Token de acesso de longa duração (long-lived) da Threads API.
# Gere no painel do seu app na Meta com as permissoes:
#   - threads_basic
#   - threads_keyword_search
THREADS_ACCESS_TOKEN=cole_seu_token_aqui

# App ID e App Secret (necessarios para o refresh do token)
THREADS_APP_ID=seu_app_id
THREADS_APP_SECRET=seu_app_secret

# Configuracoes opcionais
# Numero maximo de paginas a percorrer por palavra-chave
MAX_PAGES=3
# Tipo padrao de busca: RECENT ou TOP
SEARCH_TYPE=RECENT
